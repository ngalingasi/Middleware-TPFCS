# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=gepg_bridge
DB_PORT=3306

# GePG Configuration (API v5.0)
GEPG_IP=your_gepg_ip
GEPG_PORT=your_gepg_port
GEPG_SP_CODE=SP023
GEPG_SUB_SP_CODE=2001
# SysCode (v5) - service provider system identification code. Falls back to
# GEPG_SP_SYS_ID if unset, kept for continuity with pre-v5 .env files.
GEPG_SYS_CODE=tjv47
GEPG_SP_SYS_ID=tjv47
# SpGrpCode (v5) - for the Normal Bill Control Number flow this equals
# GEPG_SP_CODE; only set it separately if GePG instructs otherwise.
GEPG_SP_GRP_CODE=
GEPG_COM=default.sp.in
# Encryption/signature algorithm identifier - "shall be given during the
# integration" per GePG API v5.0 section 2.1. Placeholder until confirmed.
GEPG_ALG=

# GePG v5 endpoint paths - "shall be communicated during integration
# process" per API v5.0 section 1.6, not published as fixed paths like v4
# was. Leave unset to fall back to the last known-good v4 paths in
# gepgClient.js until GePG confirms the v5 equivalents.
GEPG_ENDPOINT_BILL_SUBMISSION=
GEPG_ENDPOINT_BILL_REUSE=
GEPG_ENDPOINT_BILL_UPDATE=
GEPG_ENDPOINT_BILL_CANCELLATION=
GEPG_ENDPOINT_RECONCILIATION=

# Digital Signature Configuration
# Path to your PKCS12 certificate file
CERT_PATH=./certificates/sp_certificate.p12
CERT_PASSWORD=your_cert_password
GEPG_PUBLIC_CERT_PATH=./certificates/gepg_public_cert.pem

# API Keys
API_SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info

# Most of the values below and the GePG section above can also be set by an admin on
# the Settings page. A value saved there wins; the .env value is used when none is saved.
# UAT or PRODUCTION: shows a banner on every page while UAT.
GEPG_ENVIRONMENT=
# GePG's code for your collection centre, used for new bills that do not give one.
GEPG_COLL_CENT_CODE=
# ── Printable bill / receipt / transfer bill (see services/printService.js) ──
# Institution name printed in the heading of every bill and receipt.
GEPG_SP_NAME=
# Optional second heading line (e.g. parent ministry).
GEPG_SP_SUBTITLE=
# Printed as "Collection Centre" on bills.
GEPG_COLLECTION_CENTRE_NAME=
# GePG paybill number for the QR code "shortCode" (QR spec v1.2). Get it from
# GePG - there is deliberately no default, a wrong value misroutes payments.
GEPG_QR_SHORT_CODE=
# Show mobile-money (USSD) instructions on TZS bills. Set false if the
# collection account is not with NMB.
PRINT_MOBILE_MONEY=true
# Only needed for the TISS/SWIFT transfer bill:
GEPG_TRANSFER_BENEFICIARY_NAME=
GEPG_TRANSFER_BANK_NAME=
GEPG_TRANSFER_ACCOUNT_NUMBER=
GEPG_TRANSFER_SWIFT_CODE=
# Logo images served by the frontend (public/images/gepg/)
PRINT_LOGO_COAT_OF_ARMS=/images/gepg/coat-of-arms.png
PRINT_LOGO_GEPG=/images/gepg/gepg-logo.png

# Logging
# nginx on this server sets X-Forwarded-For; trust only it (a hop count such as 1 also works)
TRUST_PROXY=loopback
# How long the database keeps logs is set on the Settings page (default 90 days raw messages, 365 audit).
# These two are only the starting values until it is saved there:
LOG_DB_DAYS_MESSAGES=90
LOG_DB_DAYS_AUDIT=365
