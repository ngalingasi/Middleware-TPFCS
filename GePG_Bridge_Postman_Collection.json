{
  "info": {
    "name": "GePG Bridge - Child System Integration",
    "_postman_id": "gepg-bridge-child-system-collection",
    "description": "API collection for external child systems integrating with the GePG Bridge to submit bills, check payment status, and request reconciliation data.\n\nAuthentication: every request here uses an API key (X-Api-Key header), issued by a bridge administrator via POST /api/api-keys. Set your key as the `api_key` collection variable below - it is shown only once at creation time, so keep it safe.\n\nThis collection intentionally excludes the bridge's own admin/dashboard endpoints (Auth, Users, Logs, Dashboard stats) and GePG's inbound webhook endpoints (those are called by GePG itself, authenticated via digital signature, not by a child system).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-Api-Key", "type": "string" },
      { "key": "value", "value": "{{api_key}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5001",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "",
      "type": "string",
      "description": "Get this from your bridge administrator - created via POST /api/api-keys (admin-only, JWT login required)."
    }
  ],
  "item": [
    {
      "name": "Bills",
      "item": [
        {
          "name": "Create Bill",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"billId\": \"BILL001\",\n  \"billAmount\": 50000,\n  \"miscAmount\": 0,\n  \"billExpiryDate\": \"2027-12-31T23:59:59\",\n  \"payerId\": \"P001\",\n  \"payerName\": \"John Doe\",\n  \"payerCellNumber\": \"255712345678\",\n  \"payerEmail\": \"john@example.com\",\n  \"billDescription\": \"Service payment\",\n  \"currency\": \"TZS\",\n  \"billEquivAmount\": 50000,\n  \"reminderFlag\": true,\n  \"billPayOption\": 1,\n  \"items\": [\n    {\n      \"billItemRef\": \"ITEM001\",\n      \"billItemAmount\": 50000,\n      \"billItemEquivAmount\": 50000,\n      \"billItemMiscAmount\": 0,\n      \"gfsCode\": \"140206\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/bills/create",
              "host": ["{{base_url}}"],
              "path": ["api", "bills", "create"]
            },
            "description": "billId is your own bill/transaction reference - you choose it, the bridge never generates it. It must be unique and is what you'll use in every subsequent lookup (Get Bill by ID, Get Bill Status)."
          }
        },
        {
          "name": "Create and Submit Bill",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"billId\": \"BILL002\",\n  \"billAmount\": 75000,\n  \"billExpiryDate\": \"2027-12-31T23:59:59\",\n  \"payerId\": \"P002\",\n  \"payerName\": \"Jane Smith\",\n  \"payerCellNumber\": \"255722345678\",\n  \"payerEmail\": \"jane@example.com\",\n  \"billDescription\": \"License fee\",\n  \"currency\": \"TZS\",\n  \"billPayOption\": 1,\n  \"items\": [\n    {\n      \"billItemRef\": \"LIC001\",\n      \"billItemAmount\": 75000,\n      \"gfsCode\": \"140206\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/bills/create-and-submit",
              "host": ["{{base_url}}"],
              "path": ["api", "bills", "create-and-submit"]
            },
            "description": "Creates the bill and submits it to GePG in one call. The response is only GePG's immediate acknowledgement (bill received) - the actual approval/rejection and control number arrive asynchronously; poll Get Bill Status afterward."
          }
        },
        {
          "name": "Submit Bill to GePG",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/bills/submit/BILL001",
              "host": ["{{base_url}}"],
              "path": ["api", "bills", "submit", "BILL001"]
            },
            "description": "Submits a previously created (not-yet-submitted) bill to GePG."
          }
        },
        {
          "name": "Cancel Bill",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Customer requested cancellation\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/bills/cancel/BILL001",
              "host": ["{{base_url}}"],
              "path": ["api", "bills", "cancel", "BILL001"]
            }
          }
        },
        {
          "name": "Get All Bills",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/bills?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "bills"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "status", "value": "PENDING", "disabled": true },
                { "key": "controlNumber", "value": "", "disabled": true },
                { "key": "startDate", "value": "2027-01-01", "disabled": true },
                { "key": "endDate", "value": "2027-12-31", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Bill by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/bills/BILL001",
              "host": ["{{base_url}}"],
              "path": ["api", "bills", "BILL001"]
            },
            "description": "Full bill detail: bill fields, items, and its payment history (payments array), plus a computed isPaid/totalPaid/remainingAmount summary."
          }
        },
        {
          "name": "Get Bill Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/bills/BILL001/status",
              "host": ["{{base_url}}"],
              "path": ["api", "bills", "BILL001", "status"]
            },
            "description": "Lightweight status-only check - use this for polling \"has this bill been paid\" using the billId you originally submitted, without pulling the full bill/items/payments payload.\n\nReturns: status, paymentControlNumber, isPaid, totalPaid, remainingAmount.\n\nNote: isPaid mirrors the bill's status column, which today is set to PAID on the *first* payment received even for a partially-paid bill (BillPayOpt PARTIAL/LIMITED). If you need to know the bill is *fully* settled rather than just \"a payment arrived\", check remainingAmount === 0 rather than isPaid alone."
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Get All Payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/payments?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "payments"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "status", "value": "PENDING", "disabled": true },
                { "key": "billId", "value": "BILL001", "disabled": true },
                { "key": "startDate", "value": "2027-01-01", "disabled": true },
                { "key": "endDate", "value": "2027-12-31", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Payment by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/payments/1",
              "host": ["{{base_url}}"],
              "path": ["api", "payments", "1"]
            },
            "description": "1 here is the payments table's own numeric id (from the Get All Payments list), not the billId."
          }
        },
        {
          "name": "Get Payment Statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/payments/statistics/summary?startDate=2027-01-01&endDate=2027-12-31",
              "host": ["{{base_url}}"],
              "path": ["api", "payments", "statistics", "summary"],
              "query": [
                { "key": "startDate", "value": "2027-01-01" },
                { "key": "endDate", "value": "2027-12-31" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Reconciliation",
      "item": [
        {
          "name": "Submit Reconciliation Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionDate\": \"2027-01-15\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/reconciliation/request",
              "host": ["{{base_url}}"],
              "path": ["api", "reconciliation", "request"]
            },
            "description": "Asks GePG for the previous working day's successful-payments batch (transactionDate, format YYYY-MM-DD). The result arrives asynchronously via GePG's own webhook - poll Get Reconciliation Request by ID afterward."
          }
        },
        {
          "name": "Get All Reconciliation Requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/reconciliation?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "reconciliation"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "status", "value": "COMPLETED", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Reconciliation Request by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/reconciliation/1700000000000",
              "host": ["{{base_url}}"],
              "path": ["api", "reconciliation", "1700000000000"]
            },
            "description": "The id here is the reconciliationRequestId returned by Submit Reconciliation Request."
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "auth": { "type": "noauth" },
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "No authentication required - use this to confirm the bridge is reachable before troubleshooting an auth issue."
      }
    }
  ]
}
