    {
      "_id": "req_createBill",
      "_type": "request",
      "parentId": "fld_bills",
      "name": "Create a bill and send it to GePG",
      "method": "POST",
      "url": "{{ _.base_url }}/api/v1/bills",
      "description": "Saves the bill and sends it to GePG. GePG answers in two steps: an immediate acknowledgement (this response) and, a moment later, the control number as a bill.approved event.\n\nA 201 means GePG received the bill, not that it approved it. Wait for the bill.approved or bill.rejected event, or check the status.",
      "headers": [
        {
          "name": "X-Api-Key",
          "value": "{{ _.api_key }}"
        },
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "parameters": [],
      "authentication": {},
      "metaSortKey": 5,
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"billId\": \"INV-{% now 'millis', '' %}\",\n  \"billAmount\": 500000,\n  \"billEquivAmount\": 500000,\n  \"billExpiryDate\": \"2027-12-17T12:00:00\",\n  \"payerId\": \"P1001\",\n  \"payerName\": \"Vidah Mwakyusa\",\n  \"payerCellNumber\": \"255786030028\",\n  \"payerEmail\": \"vidah@example.com\",\n  \"billDescription\": \"Sale of tender document\",\n  \"currency\": \"TZS\",\n  \"billPayOption\": 2,\n  \"items\": [\n    {\n      \"billItemRef\": \"TND-77\",\n      \"billItemAmount\": 500000,\n      \"billItemEquivAmount\": 500000,\n      \"gfsCode\": \"140368\"\n    }\n  ]\n}"
      }
    },
