{
  "_type": "export",
  "__export_format": 4,
  "__export_date": "2026-09-02T00:00:00.000Z",
  "__export_source": "insomnia.desktop.app:v2023.5.0",
  "resources": [
    {
      "_id": "wrk_gepg",
      "parentId": null,
      "_type": "workspace",
      "name": "GePG Bridge - Child System Integration",
      "description": "API collection for external child systems integrating with the GePG Bridge to submit bills, check payment status, and request reconciliation data.\n\nAuthentication: every request here uses an API key (X-Api-Key header), issued by a bridge administrator via POST /api/api-keys. Set your key in the api_key environment variable below - it is shown only once at creation time, so keep it safe.\n\nThis collection intentionally excludes the bridge's own admin/dashboard endpoints (Auth, Users, Logs, Dashboard stats) and GePG's inbound webhook endpoints (those are called by GePG itself, authenticated via digital signature, not by a child system)."
    },
    {
      "_id": "env_base",
      "parentId": "wrk_gepg",
      "_type": "environment",
      "name": "Base Environment",
      "data": {
        "base_url": "http://localhost:5001",
        "api_key": ""
      }
    },
    {
      "_id": "req_create_bill",
      "parentId": "fld_bills",
      "_type": "request",
      "name": "Create Bill",
      "method": "POST",
      "url": "{{ _.base_url }}/api/bills/create",
      "headers": [{ "name": "X-Api-Key", "value": "{{ _.api_key }}" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"billId\": \"BILL001\",\n  \"billAmount\": 50000,\n  \"miscAmount\": 0,\n  \"billExpiryDate\": \"2027-12-31T23:59:59\",\n  \"payerId\": \"P001\",\n  \"payerName\": \"John Doe\",\n  \"payerCellNumber\": \"255712345678\",\n  \"payerEmail\": \"john@example.com\",\n  \"billDescription\": \"Service payment\",\n  \"currency\": \"TZS\",\n  \"billEquivAmount\": 50000,\n  \"reminderFlag\": true,\n  \"billPayOption\": 1,\n  \"items\": [\n    {\n      \"billItemRef\": \"ITEM001\",\n      \"billItemAmount\": 50000,\n      \"billItemEquivAmount\": 50000,\n      \"billItemMiscAmount\": 0,\n      \"gfsCode\": \"140206\"\n    }\n  ]\n}"
      },
      "description": "billId is your own bill/transaction reference - you choose it, the bridge never generates it. Must be unique; used in every subsequent lookup."
    },
    {
      "_id": "req_create_submit_bill",
      "parentId": "fld_bills",
      "_type": "request",
      "name": "Create and Submit Bill",
      "method": "POST",
      "url": "{{ _.base_url }}/api/bills/create-and-submit",
      "headers": [{ "name": "X-Api-Key", "value": "{{ _.api_key }}" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"billId\": \"BILL002\",\n  \"billAmount\": 75000,\n  \"billExpiryDate\": \"2027-12-31T23:59:59\",\n  \"payerId\": \"P002\",\n  \"payerName\": \"Jane Smith\",\n  \"payerCellNumber\": \"255722345678\",\n  \"payerEmail\": \"jane@example.com\",\n  \"billDescription\": \"License fee\",\n  \"currency\": \"TZS\",\n  \"billPayOption\": 1,\n  \"items\": [\n    {\n      \"billItemRef\": \"LIC001\",\n      \"billItemAmount\": 75000,\n      \"gfsCode\": \"140206\"\n    }\n  ]\n}"
      },
      "description": "Creates and submits to GePG in one call. Response is only GePG's immediate ack - poll Get Bill Status afterward for the real outcome."
    },
    {
      "_id": "req_submit_bill",
      "parentId": "fld_bills",
      "_type": "request",
      "name": "Submit Bill to GePG",
      "method": "POST",
      "url": "{{ _.base_url }}/api/bills/submit/BILL001",
      "headers": [{ "name": "X-Api-Key", "value": "{{ _.api_key }}" }]
    },
    {
      "_id": "req_cancel_bill",
      "parentId": "fld_bills",
      "_type": "request",
      "name": "Cancel Bill",
      "method": "POST",
      "url": "{{ _.base_url }}/api/bills/cancel/BILL001",
      "headers": [{ "name": "X-Api-Key", "value": "{{ _.api_key }}" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"reason\": \"Customer requested cancellation\"\n}"
      }
    },
    {
      "_id": "req_get_bills",
      "parentId": "fld_bills",
      "_type": "request",
      "name": "Get All Bills",
      "method": "GET",
      "url": "{{ _.base_url }}/api/bills?page=1&limit=20",
      "headers": [{ "name": "X-Api-Key", "value": "{{ _.api_key }}" }]
    },
    {
      "_id": "req_get_bill",
      "parentId": "fld_bills",
      "_type": "request",
      "name": "Get Bill by ID",
      "method": "GET",
      "url": "{{ _.base_url }}/api/bills/BILL001",
      "headers": [{ "name": "X-Api-Key", "value": "{{ _.api_key }}" }],
      "description": "Full bill detail: bill fields, items, payment history (payments array), and isPaid/totalPaid/remainingAmount."
    },
    {
      "_id": "req_get_bill_status",
      "parentId": "fld_bills",
      "_type": "request",
      "name": "Get Bill Status",
      "method": "GET",
      "url": "{{ _.base_url }}/api/bills/BILL001/status",
      "headers": [{ "name": "X-Api-Key", "value": "{{ _.api_key }}" }],
      "description": "Lightweight paid/unpaid poll using the billId you submitted. Returns status, paymentControlNumber, isPaid, totalPaid, remainingAmount.\n\nNote: isPaid mirrors the bill's status column, set to PAID on the *first* payment even for a partially-paid (PARTIAL/LIMITED) bill - check remainingAmount === 0 if you need \"fully settled\" rather than just isPaid."
    },
    {
      "_id": "req_get_payments",
      "parentId": "fld_payments",
      "_type": "request",
      "name": "Get All Payments",
      "method": "GET",
      "url": "{{ _.base_url }}/api/payments?page=1&limit=20",
      "headers": [{ "name": "X-Api-Key", "value": "{{ _.api_key }}" }]
    },
    {
      "_id": "req_get_payment",
      "parentId": "fld_payments",
      "_type": "request",
      "name": "Get Payment by ID",
      "method": "GET",
      "url": "{{ _.base_url }}/api/payments/1",
      "headers": [{ "name": "X-Api-Key", "value": "{{ _.api_key }}" }],
      "description": "1 here is the payments table's own numeric id, not the billId."
    },
    {
      "_id": "req_payment_stats",
      "parentId": "fld_payments",
      "_type": "request",
      "name": "Get Payment Statistics",
      "method": "GET",
      "url": "{{ _.base_url }}/api/payments/statistics/summary?startDate=2027-01-01&endDate=2027-12-31",
      "headers": [{ "name": "X-Api-Key", "value": "{{ _.api_key }}" }]
    },
    {
      "_id": "req_submit_reconciliation",
      "parentId": "fld_reconciliation",
      "_type": "request",
      "name": "Submit Reconciliation Request",
      "method": "POST",
      "url": "{{ _.base_url }}/api/reconciliation/request",
      "headers": [{ "name": "X-Api-Key", "value": "{{ _.api_key }}" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"transactionDate\": \"2027-01-15\"\n}"
      },
      "description": "Asks GePG for the previous working day's successful-payments batch. Result arrives asynchronously via GePG's webhook - poll Get Reconciliation Request by ID afterward."
    },
    {
      "_id": "req_get_reconciliations",
      "parentId": "fld_reconciliation",
      "_type": "request",
      "name": "Get All Reconciliation Requests",
      "method": "GET",
      "url": "{{ _.base_url }}/api/reconciliation?page=1&limit=20",
      "headers": [{ "name": "X-Api-Key", "value": "{{ _.api_key }}" }]
    },
    {
      "_id": "req_get_reconciliation",
      "parentId": "fld_reconciliation",
      "_type": "request",
      "name": "Get Reconciliation Request by ID",
      "method": "GET",
      "url": "{{ _.base_url }}/api/reconciliation/1700000000000",
      "headers": [{ "name": "X-Api-Key", "value": "{{ _.api_key }}" }],
      "description": "The id here is the reconciliationRequestId returned by Submit Reconciliation Request."
    },
    {
      "_id": "req_health",
      "parentId": "wrk_gepg",
      "_type": "request",
      "name": "Health Check",
      "method": "GET",
      "url": "{{ _.base_url }}/health",
      "description": "No authentication required."
    },
    {
      "_id": "fld_bills",
      "parentId": "wrk_gepg",
      "_type": "request_group",
      "name": "Bills"
    },
    {
      "_id": "fld_payments",
      "parentId": "wrk_gepg",
      "_type": "request_group",
      "name": "Payments"
    },
    {
      "_id": "fld_reconciliation",
      "parentId": "wrk_gepg",
      "_type": "request_group",
      "name": "Reconciliation"
    }
  ]
}
